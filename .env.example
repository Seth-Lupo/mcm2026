# Tufts HPC Configuration
# Copy to .env and fill in your values: cp .env.example .env

# =============================================================================
# REQUIRED - Your Tufts credentials
# =============================================================================

# Your Tufts username (UTLN)
TUFTS_USER=your_utln

# Email for job notifications (END/FAIL alerts)
TUFTS_EMAIL=your.name@tufts.edu

# GitHub repo URL (for cloning on cluster)
GITHUB_REPO=https://github.com/your-username/mcm2026.git

# =============================================================================
# OPTIONAL - Local settings
# =============================================================================

# Where to download results locally
LOCAL_RESULTS_DIR=./cluster_results

# =============================================================================
# NOTE: Experiment settings are in region-analysis/config.yaml
# =============================================================================
